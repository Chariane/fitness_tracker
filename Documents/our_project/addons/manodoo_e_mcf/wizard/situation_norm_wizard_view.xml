<?xml version="1.0" encoding="UTF-8"?>
<openerp>
	<data>
		<!--WIZARD FORMAT-->
		<record id="situation_norm_view" model="ir.ui.view">
			<field name="name">Situation factures normalisées</field>
			<field name="model">situation_norm_wizard</field>
			<field name="arch" type="xml">
				<form string="Situation">
					<group col="12">
			     		<!-- <group> -->
			     			<field name="date_deb"/>
			     			<field name="date_fin"/>
			     		<!-- </group> -->
			     		
		     		</group>
		     	<!-- <label for="employee_ids"/>	
		     	<field name="employee_ids"/> -->
		        <footer>
		    		<button string="Imprimer" name="print_report" type="object" class="oe_highlight" /> or
		    		<!-- <button string="Print Excel Report" name="print_excel" type="object" class="oe_highlight" /> or -->
		            <button string="Cancel" class="oe_link" special="cancel" />
		        </footer>
				</form>
			</field>
		</record>
		

		<!--WIZARD ACTION-->
		<record id="action_situation_norm" model="ir.actions.act_window">
			<field name="name">Situation Factures normalisées</field>
			<field name="type">ir.actions.act_window</field>
			<field name="res_model">situation_norm_wizard</field>
			<field name="view_type">form</field>
			<!-- <field name="view_id" ref="livrepaie_new_view"/> -->
			<field name="view_mode">form</field>
			<field name="target">new</field>
		</record>

		<!--MENU WHICH OPENS WIZARD-->
		<menuitem id="situation_norm_menu" sequence="200" 
				  name="Situation factures normalisées" parent="account.menu_finance_reports"
				  action="action_situation_norm" />

	</data>
</openerp>