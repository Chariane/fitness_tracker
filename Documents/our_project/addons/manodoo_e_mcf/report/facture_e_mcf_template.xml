<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <template id="report_invoice_e_mcf_template">
            <t t-foreach="docs" t-as="o">
                <t t-call="report.external_layout" style="height:50px">
                    <div class="page" style="position: relative; height:1090px;">
                        <span t-esc="check_if_norm()"/>

                        <div>
                            <div class="row">
                                <div class="col-xs-12" style="border: 1px solid #bfbfbf; background:#dfdfdf">
                                    <h4 class="text-center" style="text-transform:uppercase"><strong>
                                    <span t-if="o.type == 'out_invoice' and (o.state == 'open' or o.state == 'paid')">FACTURE DE VENTE <span t-if="o.type_fact == 'EV'">A L'EXPORTATION </span>:</span>
                                    <span t-if="o.type == 'out_invoice' and o.state == 'proforma2'">PRO-FORMA</span>
                                    <span t-if="o.type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                                    <span t-if="o.type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                                    <span t-if="o.type == 'out_refund'">FACTURE D'AVOIR <span t-if="o.type_fact == 'EA'">A L'EXPORTATION </span>:</span>
                                    <span t-if="o.type == 'in_refund'">Supplier Refund</span>
                                    <span t-if="o.type == 'in_invoice'">Supplier Invoice</span>
                                    <!-- <span t-if="o.type_fact == 'EV' or o.type_fact == 'EA'">Exportation</span> -->
                                    <span t-field="o.number"/></strong>
                                    </h4>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-xs-5" style="float:right; border:solid 1px #bfbfbf; border-radius:20px 20px 20px 20px; padding:10px; margin-top:3px">
                                    <strong>Client :</strong>
                                    <!-- <t t-if="o.client"> -->
                                        <address t-field="o.partner_id"
                                            t-field-options='{"widget": "contact", "fields": ["address", "name", "ifu"], "no_marker": true}' />
                                        <span t-if="o.partner_id.ifu">IFU: <span t-field="o.partner_id.ifu"/></span>
                                    <!-- </t> -->
                                    <span></span>
                                </div>
                            </div>

                            <!-- <span t-if="o.type == 'out_refund'">
                                <span t-if="o.rn">Facture initiale : <span t-field="o.rn"/></span>
                            </span> -->

                            <div class="row mt32 mb32">
                                <div class="col-xs-2" t-if="o.name">
                                    <strong>Description:</strong>
                                    <p t-field="o.name"/>
                                </div>
                                <div class="col-xs-2" t-if="o.date_invoice">
                                    <strong>Date facture:</strong>
                                    <p t-field="o.date_invoice"/>
                                </div>
                                <div class="col-xs-2" t-if="o.origin">
                                    <strong>Source:</strong>
                                    <p t-field="o.origin"/>
                                </div>
                                <div class="col-xs-2" t-if="o.partner_id.ref">
                                    <strong>Customer Code:</strong>
                                    <p t-field="o.partner_id.ref"/>
                                </div>
                                <span t-if="o.type == 'out_refund'">
                                    <div class="col-xs-4" t-if="o.rn">
                                        <strong>Facture initiale:</strong>
                                        <p t-field="o.rn"/>
                                    </div>
                                </span>
                            </div>
                            <t t-set="taux" t-value="0"/>
                            <table class="table table-condensed">
                                <thead style=" background:#dfdfdf">
                                    <tr>
                                        <th>Description</th>
                                        <th>Quantité</th>
                                        <th class="text-right">PU TTC</th>
                                        <!-- <th class="text-right">PU HT</th> -->
                                        <th class="text-right" groups="sale.group_discount_per_so_line">Remise</th>
                                        <th class="text-right">Taxes</th>
                                        <th class="text-right">Montant HT</th>
                                    </tr>
                                </thead>
                                <tbody class="invoice_tbody">
                                    <tr t-foreach="o.invoice_line" t-as="l">
                                        <t t-set="pu_ttc" t-value="0"/>
                                        <t t-set="qte" t-value="0"/>
                                        <t t-set="mtt_ttc" t-value="0"/>
                                        <!-- <t t-set="netp_total" t-value="0"/> -->

                                        <td>
                                            <span t-field="l.name"/>
                                        </td>
                                        

                                        <td>
                                            <t t-set="qte" t-value="l.quantity"/>
                                            <span t-field="l.quantity"/>
                                            <span t-field="l.uos_id"  groups="product.group_uom"/>
                                        </td>
                                        <td class="text-right">
                                            <t t-set="pu_ttc" t-value="l.price_unit"/>
                                            <span t-field="l.price_unit"/>
                                        </td>
                                        <!-- <td class="text-right">
                                            <span t-field="l.pu_ht"/>
                                        </td> -->
                                        <td class="text-right" groups="sale.group_discount_per_so_line"><span t-field="l.remise_montant"/></td>
                                        <td class="text-right">
                                            <t t-set="taxes" t-value="', '.join(map(lambda x: x.name+ '['+x.groupe_taxation_id.reference+']', l.invoice_line_tax_id))"/>
                                            <span t-esc="taxes"/>
                                            <t t-if="'5' in taxes">
                                                <t t-set="taux" t-value="5" />
                                                <!-- <t t-esc="taux" /> -->
                                            </t>
                                            <t t-if="'1' in taxes">
                                                <t t-set="taux" t-value="1" />
                                                <!-- <t t-esc="taux" /> -->
                                            </t>
                                        </td>
                                        <td class="text-right">
                                            <t t-set="mtt_ttc" t-value="qte*pu_ttc"/>
                                            <span t-field="l.price_subtotal" />
                                            
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <!-- <div class="row" t-if="o.tax_line"> -->
                            <div class="row" >
                                <div class="col-xs-6">
                                    <table class="table table-condensed">
                                        <thead style=" background:#dfdfdf">
                                            <tr>
                                                <th>Total</th>
                                                <th class="text-right">Montant</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            
                                            <t t-if="o.hab  != 0">
                                                <tr>
                                                    <td>Total H.T. [B] 18%</td>
                                                    <td class="text-right">
                                                        <t t-esc="'{0:,.0f}'.format(int(o.hab-o.ts)).replace(',', ' ')" />
                                                    </td>
                                                </tr>
                                            </t>
                                           
                                            <t t-if="o.had  != 0">
                                                <tr>
                                                    <td>Total H.T. [D] 18%</td>
                                                    <td class="text-right">
                                                        <t t-esc="'{0:,.0f}'.format(int(o.had)).replace(',', ' ')" />
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="o.ts != 0">
                                                <tr>
                                                    <td>Total T.S.
                                                        <t t-if="o.vad != 0">[D] 18%</t>
                                                        <t t-if="o.vab != 0">[B] 18%</t>
                                                        <t t-if="o.tae != 0">[E] 0%</t>
                                                    </td>
                                                    <td class="text-right">
                                                        <t t-esc="'{0:,.0f}'.format(int(o.ts)).replace(',', ' ')" />
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="o.vab != 0">
                                                <tr>
                                                    <td>Total TVA [B] 18%</td>
                                                    <td class="text-right">
                                                        <t t-esc="'{0:,.0f}'.format(int(o.vab)).replace(',', ' ')" />
                                                    </td>
                                                </tr>
                                            </t>
                                          
                                            <t t-if="o.vad != 0">
                                                <tr>
                                                    <td>Total TVA [D] 18%</td>
                                                    <td class="text-right">
                                                        <t t-esc="'{0:,.0f}'.format(int(o.vad)).replace(',', ' ')" />
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="o.tac != 0">
                                                <tr>
                                                    <td>Total H.T. [C] 0%</td>
                                                    <td class="text-right">
                                                        <t t-esc="'{0:,.0f}'.format(int(o.tac)).replace(',', ' ')" />
                                                        
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td>Total TVA [C] 0%</td>
                                                    <td class="text-right">
                                                        0
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="o.taa != 0">
                                                <tr>
                                                    <td>EXONERES</td>
                                                    <td class="text-right">
                                                        <t t-esc="'{0:,.0f}'.format(int(o.taa)).replace(',', ' ')" />
                                                        
                                                    </td>
                                                </tr>
                                            </t>
                            
                                            <t t-if="o.tae">
                                                <tr>
                                                    <td>REGIME TPS [E]</td>
                                                    <td class="text-right">
                                                        <t t-esc="'{0:,.0f}'.format(int(o.tae)).replace(',', ' ')" />
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="o.taf">
                                                <tr>
                                                    <td>RESERVES [F]</td>
                                                    <td class="text-right">
                                                        <t t-esc="'{0:,.0f}'.format(int(o.taf)).replace(',', ' ')" />
                                                    </td>
                                                </tr>
                                            </t>
                                            
                                            <t t-if="o.aib != 0">
                                                <tr>
                                                    <td>AIB <t t-esc="taux" />%</td>

                                                    <td class="text-right">
                                                        <t t-esc="'{0:,.0f}'.format(int(o.aib)).replace(',', ' ')" />
                                                    </td>
                                                </tr>
                                            </t>
                                            <t t-if="o.total != 0">
                                                <tr>
                                                    <td><strong>Total TTC</strong></td>
                                                    <td class="text-right">
                                                        <strong><t t-esc="'{0:,.0f}'.format(int(o.total)).replace(',', ' ')" /></strong>
                                                    </td>
                                                </tr>
                                            </t>
                                            
                                        </tbody>
                                    </table>

                                    <!-- Paiement -->
                                    <table class="table table-condensed">
                                        <tr class="border-black">
                                            <td>Paiement - 
                                                <span t-if="o.payment_method_id">
                                                    <span t-esc="o.payment_method_id.type_paiement_id.name">
                                                    </span>
                                                </span>
                                                <span t-if="not o.payment_method_id">
                                                    Espèces
                                                </span>
                                            </td>
                                            <td class="text-right">
                                                <t t-esc="'{0:,.0f}'.format(int(o.amount_total)).replace(',', ' ')" />
                                            </td>
                                        </tr>
                                    </table>
                                    <p>
                                        <strong>Arrêtée la facture à la somme de </strong>
                                        
                                        <!-- <span t-esc="o.amount_text"/> -->
                                            
                                    </p>
                                </div>
                                <div class="col-xs-6 pull-right">
                                    <p class="text-right"><strong>Vendeur: </strong>
                                    <span t-esc="o.norm_by.id"/>
                                    <span t-esc="o.norm_by.name"/></p><br/>

                                    <p class="text-right">
                                        <strong>Nous vous remercions pour la confiance</strong>   
                                    </p>
                                    <p class="text-right">Cotonou, le <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/> </p>
                                    <p class="text-right mt64"><u>John Doe</u></p>
                                    <p class="text-right"><em>CEO Odoo</em></p>
                                </div>
                                
                                        
                            </div>
                            
                        </div>

                        
                        

                        <p t-if="o.comment">
                            <strong>Comment:</strong>
                            <span t-field="o.comment"/>
                        </p>
                        <p t-if="o.payment_term.note">
                            <strong>Conditions de paiement:</strong>
                            <span t-field="o.payment_term.note"/>
                        </p>
                        <p t-if="o.fiscal_position.note">
                            <strong>Fiscal Position Remark:</strong>
                            <span t-field="o.fiscal_position.note"/>
                        </p>

                        
                        
                        <div style="clear:both"></div>
                        <!-- </div>====== -->


                        <!-- ============================MECef Signature======================== -->
                        <div style="width:100%; position: absolute; bottom:0; text-align:center">
                            <div style="width:60%; float:left; text-align:center;">
                                <table class="table table-borderless table-condensed">
                                    <span>Code MECeF/DGI :</span><br/>
                                    <strong><span t-esc="o.code_mecef_dgi_norm"/></strong>
                                    <tr>
                                    
                                        <td>MEcef NIM :</td>
                                        <td class="text-right">
                                            <span t-esc="o.nim_norm"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>MEcef compteur :</td>
                                        <td class="text-right">
                                            <span t-esc="o.counters_norm"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>MEcef Heure :</td>
                                        <td class="text-right">
                                            <span t-esc="o.datetime_norm"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div style="float:right">
                                <img t-att-src="o.get_qr_code()" style="150px;height:150px"/> 
                            </div>
                            <div style="clear:both"></div>
                            
                        </div>
                        <!-- =================================================================== --> 
                    </div>
                    <!-- </div> -->
                </t>
            </t>
        </template>
    </data>
</openerp>