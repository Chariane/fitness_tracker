<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <template id="situation_norm_template_id">
            <t t-call="report.external_layout">
                <t t-call="report.html_container">
                    <div class="page">
                        <t t-foreach="docs" t-as="o">
                            <div class="row">
                                <h2 style="text-align: center; background-color:#00a09e; color:white; padding: 1%; font-weight:bold; font-family: Arial;">FACTURES NON NORMALISEES </h2>
                                <br/>
                                <div style="width:66%; float:left; margin-bottom: 20px">
                                    <strong><span style="font-size:0.9em;">Période: </span></strong>
                                    <span style="font-size:1em;">
                                        <span t-field="o.date_deb" t-field-options="{&quot;format&quot;: &quot;dd/MM/yyyy&quot;}"/> - <span t-field="o.date_fin" t-field-options="{&quot;format&quot;: &quot;dd/MM/yyyy&quot;}"/>
                                    </span>
                                    
                                </div>
                                
                                <table line-height="100%" class="table table-condensed table-bordered">
                                    <thead>
                                        <tr>
                                            <td width="1%">
                                                <center>
                                                    <strong>N°</strong>
                                                </center>
                                            </td>
                                            <td width="10%">
                                                <center>
                                                    <strong>Date</strong>
                                                </center>
                                            </td>
                                            <td width="10%">
                                                <center>
                                                    <strong>Référence</strong>
                                                </center>
                                            </td>
                                            <td width="20%">
                                                <center>
                                                    <strong>Type</strong>
                                                </center>
                                            </td>
                                            <td >
                                                <center>
                                                    <strong>Client</strong>
                                                </center>
                                            </td>
                                            <td width="20%">
                                                <center>
                                                    <strong>Montant total</strong>
                                                </center>
                                            </td>
                                            <!-- <td width="3%">
                                                <center>
                                                    <strong>Situation matrimoniale</strong>
                                                </center>
                                            </td> -->
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="no_ordre" t-value="0"/>
                                        <t t-foreach="o.get_liste_invoices()" t-as ="invoice">
                                            <t t-set="no_ordre" t-value="no_ordre+1"/>
                                            <t t-set="type" t-value="invoice.type"/>
                                            
                                            <tr>
                                                <td>
                                                    <span t-esc="no_ordre"/>
                                                </td>
                                                <td>
                                                    <span t-esc="invoice.date_invoice" t-options='{"format": "dd/MM/yyyy"}'/>
                                                </td>
                                                <td class="text-left">
                                                    <span t-esc="invoice.number"/>
                                                </td>
                                                <td class="text-left">
                                                    <span>
                                                        <t t-if="type =='out_invoice'">
                                                            Facture client
                                                        </t>
                                                        <t t-if="type =='out_refund'">
                                                            Facture d'avoir
                                                        </t>
                                                    </span>
                                                </td>
                                                <td class="text-left">
                                                    <span t-esc="invoice.partner_id.name"/>
                                                </td>
                                                <td class="text-right">
                                                    <!-- <span t-esc="invoice.amount_total"/> -->
                                                    <t t-esc="'{0:,.2f}'.format(round(invoice.amount_total)).replace(',', ' ')"/>
                                                </td>
                                                
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                                
                            </div>
                            <div style="width:33%; float:right">
                                <span style="font-size:0.9em;">Imprimé le: </span>
                                <span t-field="o.date_impression" style="font-size:1em;"></span>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </template>
    </data>
</openerp>