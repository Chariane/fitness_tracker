<?xml version="1.0" encoding="utf-8"?>
<openerp>
    <data>
        <!-- REPORT -->
        <report id="report_invoice_e_mcf_action"
            string="Facture normalisée"
            model="account.invoice"
            report_type="qweb-pdf"
            name="manodoo_e_mcf.report_invoice_e_mcf_template"
            file="Facture normalisée"
            attachment="(object.state in ('open','paid')) and ('INV'+(object.number or '').replace('/','')+'_normalisee.pdf')"
		/>

        <report id="situation_norm_action"
            string="Situation factures normalisées"
            model="situation_norm_wizard"
            report_type="qweb-pdf"
            name="manodoo_e_mcf.situation_norm_template_id"
            file="Situation factures normalisées"
		/>

		<record id="paperformat_rapport_A4" model="report.paperformat">
            <field name="name">A4 Rapport </field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">40</field>
            <field name="margin_bottom">23</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False" />
            <field name="header_spacing">35</field>
            <field name="dpi">90</field>
        </record>
		<record id="manodoo_e_mcf.report_invoice_e_mcf_action" model="ir.actions.report.xml">
			<field name="paperformat_id" ref="manodoo_e_mcf.paperformat_rapport_A4"/>
		</record>
        
		<record id="manodoo_e_mcf.situation_norm_action" model="ir.actions.report.xml">
			<field name="paperformat_id" ref="manodoo_e_mcf.paperformat_rapport_A4"/>
		</record>
    </data>
</openerp>