<?xml version="1.0"?>
<openerp>
    <data>
        <!-- ACCOUNT INVOICE -->
        <record model="ir.ui.view" id="view_account_invoice_e_mcf">
            <field name="name">account.invoice.e.mcf</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.invoice_form"/>
            <field name="arch" type="xml">
                <!-- <field name="partner_id" position="before">
                    <field name="facture_exportation" attrs="{'readonly':[('state','!=','draft')]}"/>
                </field> -->
                <page string="Payments" position="after">
                    <page string="Données SyGMEF">
                        <group col="2">
                            <group>
                                <!-- <field name="client" groups="base.group_system" />  -->
                                <field name="etat_norm" readonly="1" /> 
                                <field name="imprimer" readonly="1" invisible="1" /> 
                                <field name="uid_e_mcf" string="Identification de la transaction"/>
                                <field name="norm_by" widget="selection" />
                            </group>
                            <group>
                                <field name="datetime_norm" /> 
                                <field name="code_mecef_dgi_norm" /> 
                                <field name="qrcode_norm" /> 
                                <field name="nim_norm" /> 
                                <field name="counters_norm" />
                            </group>
                        </group>
                        <group col="3" groups="base.group_system">
                            <group>
                                <!-- <field name="client" groups="base.group_system" />  -->
                                <field name="type_fact" readonly="1" /> 
                                <field name="ta" readonly="1" /> 
                                <field name="tb" readonly="1" /> 
                                <field name="tc_norm" readonly="1" /> 
                                <field name="td" readonly="1" /> 
                               
                            </group>
                            <group>
                                <field name="taa" readonly="1" /> 
                                <field name="tab" readonly="1" /> 
                                <field name="tac" readonly="1" /> 
                                <field name="tad" readonly="1" /> 
                                <field name="tae" readonly="1" /> 
                                <field name="taf" readonly="1" /> 
                                <field name="hab" readonly="1" /> 
                                <field name="had" readonly="1" /> 
                            </group>
                            <group>
                                <field name="vab" readonly="1" /> 
                                <field name="vad" readonly="1" /> 
                                <field name="aib_norm" readonly="1" /> 
                                <field name="ts" readonly="1" /> 
                                <field name="total" readonly="1" /> 
                                <field name="vad" readonly="1" /> 
                                <field name="errorCode" readonly="1" /> 
                                <field name="errorDesc" readonly="1" /> 
                                
                            </group>
                           
                        </group>

                        
                    </page>
                </page>
                <xpath expr="/form/sheet/notebook/page[1]/field[1]/tree/field[@name='discount']" position="after">
                    <field name="remise_montant"/>
                    <!-- <field name="pu_ht"/> -->
                </xpath>
                <xpath expr="/form/sheet/notebook/page[1]/field[1]/tree/field[@name='invoice_line_tax_id']" position="after">
                    <!-- <field name="lettretaxe"/> -->
                    <field name="taxe_specifique"/>
                    <!-- <field name="desc_ts"/> -->
                </xpath>
                
                
               
               
            </field>
        </record>

        <!-- ACCOUNT INVOICE -->
        <record model="ir.ui.view" id="view_account_invoice2_e_mcf">
            <field name="name">account.invoice.e.mcf2</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account_cancel.invoice_form_cancel_inherit"/>
            <field name="arch" type="xml">
                <button name="invoice_cancel" position="replace">
                    <button name="invoice_cancel" attrs="{'invisible':['|', ('state', 'not in', ['open','proforma2','sale','draft']), '|', ('etat_norm', '=', True), ('imprimer', '=', True)]}" string="Cancel Invoice" groups="account.group_account_invoice" />
                </button>
            </field>
        </record>

        <!-- ACCOUNT INVOICE -->
        <record model="ir.ui.view" id="view_account_invoice3_e_mcf">
            <field name="name">account.invoice.e.mcf3</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account_voucher.view_invoice_customer"/>
            <field name="arch" type="xml">
                <button name="invoice_pay_customer" position="before">
                    <button name="normaliser" type="object" string="Normaliser la facture" attrs="{'invisible':['|', ('state', 'not in', ['open','paid']), '|', ('etat_norm','=',True), ('imprimer','=',True)]}" class="oe_highlight" groups="account.group_account_manager"/>
                </button>
            </field>
        </record>


        <record id="view_tree_account_invoice_e_mecf" model="ir.ui.view">
            <field name="name">account_invoice_tree_e_mcf</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.invoice_tree"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <field name="state" position="after">
                     <field name="etat_norm" invisible="1"/>
                     <field name="imprimer" invisible="1"/>
                </field>
                <field name="state" position="replace">
                     <field name="state" bg_color="green:etat_norm==True or imprimer==True;" fg_color="white:etat_norm==True or imprimer==True;"/>
                </field>
            </field>
        </record>

        <record id="invoice_filter_manodoo_e_mcf" model="ir.ui.view">
            <field name="name">account.invoice_filter_manodoo_e_mcf</field>
            <field name="model">account.invoice</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='unpaid']" position="after">
                    <separator/>
                        <filter string="Normalisée" name="est_normalisee" domain="['|', ('etat_norm','=', 'True'), ('imprimer','=', 'True')]"/>
                       
                    <separator/>
                </xpath>

                <xpath expr="//filter[@string='Due Month']" position="after">
                    <separator/>
                        <filter string="Normalisée ?" context="{'group_by': ['etat_norm','imprimer']}" help="Liste les factures normalisées" />
                    <separator/>
                </xpath>
                
            </field>
        </record>
        
        
    
    </data>
    
</openerp>