<?xml version="1.0"?>
<openerp>
	<data>
        <!-- ACCOUNT TAX -->
		<record model="ir.ui.view" id="view_account_tax_e_mcf">
            <field name="name">account.tax.e.mcf</field>
            <field name="model">account.tax</field>
            <field name="inherit_id" ref="account.view_tax_form"/>
            <field name="arch" type="xml">
                <page string="Special Computation" position="after">
                    <page string="Données SyGMEF">
                        <group col="2">
                            <group>
                       			<field name="groupe_taxation_id" widget="selection"/> 
                            </group>
                        </group>
                    </page>
                </page>
            </field>
        </record>  

        <!-- SEARCH -->
		<record id="view_account_tax_manodoo_search" model="ir.ui.view">
            <field name="name">account_tax_manodoo.search</field>
            <field name="model">account.tax</field>
			<field name="inherit_id" ref="account.view_account_tax_search"/>
            <field name="arch" type="xml">
				<xpath expr="//filter[@string='Tax Application']" position="after">
					<!-- <separator/> -->
                        <filter string="Groupe de taxation" context="{'group_by':'groupe_taxation_id'}"/>
					<!-- <separator/> -->
				</xpath>
            </field>
        </record>
  
	</data>
</openerp>